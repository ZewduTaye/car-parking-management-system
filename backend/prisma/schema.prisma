generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum ParkingStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reservations Reservation[]
}

model Customer {
  id           Int      @id @default(autoincrement())
  fullName     String
  phone        String
  email        String?
  carPlate     String   @unique
  carModel     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reservations    Reservation[]
  vipReservations VIPReservation[]
}

model ParkingSpace {
  id           Int           @id @default(autoincrement())
  spaceNumber  String        @unique
  location     String?
  status       ParkingStatus @default(AVAILABLE)
  isVIP        Boolean       @default(false)
  pricePerHour Float         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  reservations    Reservation[]
  vipReservations VIPReservation[]
}

model Reservation {
  id              Int               @id @default(autoincrement())
  customerId      Int
  parkingSpaceId  Int
  userId          Int?
  startTime       DateTime
  endTime         DateTime
  totalAmount     Float             @default(0)
  status          ReservationStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  parkingSpace ParkingSpace  @relation(fields: [parkingSpaceId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
}

model VIPReservation {
  id              Int               @id @default(autoincrement())
  customerId      Int
  parkingSpaceId  Int
  startTime       DateTime
  endTime         DateTime
  totalAmount     Float             @default(0)
  status          ReservationStatus @default(PENDING)
  specialRequest  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  parkingSpace ParkingSpace @relation(fields: [parkingSpaceId], references: [id])
}
